<!-- Holly, the crush -->
<svg width="86" height="96" viewBox="0 0 86 96">
  <g fill="none" stroke="#111" stroke-linecap="round" stroke-linejoin="round">
    <!-- side locks, tucked behind the head, tips flipping outward -->
    <path d="M20 38 Q9 50 7 64 Q6 74 1 79 Q9 78 13 71 Q18 60 22 50 Z" fill="#f6f1e3" stroke-width="2.2"/>
    <path d="M66 38 Q77 50 79 64 Q80 74 85 79 Q77 78 73 71 Q68 60 64 50 Z" fill="#f6f1e3" stroke-width="2.2"/>
    <!-- face -->
    <ellipse cx="43" cy="52" rx="23" ry="25" fill="#f6f1e3" stroke-width="2.5"/>
    <!-- hair cap: crown over the top, fringe sweeping down toward her left -->
    <path d="M23 37 Q16 12 43 10 Q71 12 64 48 Q42 30 23 37 Z" fill="#f6f1e3" stroke-width="2.3"/>
    <!-- the part -->
    <path d="M33 12 Q30 19 27 26" stroke-width="2"/>
    <!-- ear + earring -->
    <path d="M22 47 Q15 48 15 54 Q15 60 22 59" fill="#f6f1e3" stroke-width="2.2"/>
    <circle cx="18" cy="62.5" r="1.7" fill="#111" stroke="none"/>
    <!-- eyes -->
    <ellipse cx="34" cy="52" rx="2.5" ry="3.7" fill="#111" stroke="none"/>
    <ellipse cx="52" cy="52" rx="2.5" ry="3.7" fill="#111" stroke="none"/>
    <!-- comma nose -->
    <path transform="translate(40,57)" d="M0 0 Q7 1 6 5 Q5 8 2 7" stroke-width="2.2"/>
    <!-- small unimpressed mouth -->
    <path transform="translate(34,71)" d="M0 4 Q9 -2 18 4" stroke-width="2.3"/>
  </g>
</svg>
