    <ellipse cx="36" cy="52" rx="7.5" ry="9.5" fill="#f6f1e3" stroke-width="2.2"/>
    <ellipse cx="51" cy="52" rx="7.5" ry="9.5" fill="#f6f1e3" stroke-width="2.2"/>
    <circle cx="37" cy="54" r="1.8" fill="#111" stroke="none"/>
    <circle cx="50" cy="54" r="1.8" fill="#111" stroke="none"/>
