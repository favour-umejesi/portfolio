---
interface Props {
  title: string;
  underlineWidth: number;
  viewBoxWidth?: number;
  path: string;
}

const { title, underlineWidth, viewBoxWidth, path } = Astro.props;
const viewBox = `0 0 ${viewBoxWidth ?? underlineWidth} 12`;
---

<div class="title-block">
  <h1 class="page-title">{title}</h1>
  <svg class="title-underline" width={underlineWidth} viewBox={viewBox} preserveAspectRatio="none" aria-hidden="true">
    <path d={path} fill="none" stroke="#111" stroke-width="3" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
  </svg>
  {Astro.slots.has('doodle') && (
    <div class="corner-doodle" aria-hidden="true">
      <slot name="doodle" />
    </div>
  )}
</div>
