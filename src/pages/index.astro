---
import { getCollection } from 'astro:content';
import ResearchLayout from '../layouts/ResearchLayout.astro';
import { readSingleton } from '../lib/reader';
import { showDrafts } from '../lib/entries';

const page = await readSingleton('researchPage');
const settings = await readSingleton('settings');

const works = (await getCollection('research'))
  .filter((w) => showDrafts || !w.data.draft)
  .sort((a, b) => a.data.order - b.data.order);

const hasResearch = works.some((w) => w.data.kind === 'research');
const hasProjects = works.some((w) => w.data.kind === 'project');

const email = settings.socials.find((s) => s.url.startsWith('mailto:'));

// writing: published theories + musings, newest first
type Note = { title: string; date: Date; href: string; external: boolean; source: string };
let notes: Note[] = [];
if (page.showWriting) {
  const theories = await getCollection('theories');
  const musings = await getCollection('musings');
  notes = [
    ...theories.map((e) => ({ entry: e, base: '/theories/', source: 'theories' })),
    ...musings.map((e) => ({ entry: e, base: '/musings/', source: 'musings' })),
  ]
    .filter(({ entry }) => !entry.data.draft && entry.data.research)
    .map(({ entry, base, source }) => ({
      title: entry.data.title,
      date: entry.data.date,
      href: entry.data.externalUrl ?? `${base}${entry.id}`,
      external: Boolean(entry.data.externalUrl),
      source,
    }))
    .sort((a, b) => b.date.valueOf() - a.date.valueOf());
}

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const kindLabel = (k: string) => (k === 'research' ? 'Research' : 'Project');
const cap = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

// bio paragraphs: plain text, except ==phrase== becomes a highlight
const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const rich = (t: string) => esc(t).replace(/==(.+?)==/g, '<mark>$1</mark>');

// rotating titles under the name, CSS-only: each word gets the same
// animation, offset by its index, so the keyframes depend on the count
const roles = page.roles.filter(Boolean);
const perWord = 2.6; // seconds each word stays
const total = roles.length * perWord;
const on = (100 / roles.length).toFixed(3);
const fade = (4 / roles.length).toFixed(3);
const rotatorCss = roles.length > 1
  ? `.v-roles li { animation: v-rotate ${total}s infinite; }
@keyframes v-rotate {
  0% { opacity: 0; transform: translateY(6px); }
  ${fade}% { opacity: 1; transform: none; }
  ${(Number(on) - Number(fade)).toFixed(3)}% { opacity: 1; transform: none; }
  ${on}% { opacity: 0; transform: translateY(-6px); }
  100% { opacity: 0; }
}`
  : '';

// one simple line-icon set, drawn for this page; social ones keyed by the
// label used in site settings, anything unknown falls back to a letter
const icon = {
  about: '<circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.9 3.1-6 7-6s7 2.1 7 6"/>',
  works: '<path d="M7 3h7l4 4v14H7z"/><path d="M14 3v4h4"/><path d="M10 12h5M10 16h5"/>',
  diary: '<rect x="6" y="3" width="13" height="18" rx="2"/><path d="M4 7h4M4 12h4M4 17h4"/>',
  download: '<path d="M12 4v11"/><path d="M7 10l5 5 5-5"/><path d="M5 20h14"/>',
  arrow: '<path d="M5 12h14"/><path d="M13 6l6 6-6 6"/>',
};
const social: Record<string, string> = {
  email: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 8l9 6 9-6"/>',
  github:
    '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>',
  linkedin: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V17"/><path d="M8 7.5v.01"/><path d="M12 17v-3.5a2.25 2.25 0 0 1 4.5 0V17"/><path d="M12 10.5V17"/>',
  x: '<path d="M5 4l14 16"/><path d="M19 4L5 20"/>',
  medium: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M7 16V8l5 6 5-6v8"/>',
};
---

<ResearchLayout
  title={`${page.name} — Research`}
  description={[`${page.name}: research portfolio`, page.affiliation].filter(Boolean).join('. ') + '.'}
>
  <nav class="v-card v-sidenav" slot="sidenav" aria-label="Sections">
    <a href="#about"><svg viewBox="0 0 24 24" set:html={icon.about} />About</a>
    <a href="#works"><svg viewBox="0 0 24 24" set:html={icon.works} />Works</a>
    <a href="/diary" title="Back to the diary"><svg viewBox="0 0 24 24" set:html={icon.diary} />Diary</a>
  </nav>

  <aside class="v-card v-profile" slot="profile">
    {page.headshot
      ? <img class="v-photo" src={page.headshot} alt={page.name} />
      : <div class="v-photo--empty" aria-hidden="true"></div>}
    <div class="v-identity">
      <h1>{page.name}</h1>
      {roles.length > 0 && (
        <div class="v-role">
          <ul class="v-roles">
            {roles.map((r, i) => <li style={`animation-delay: ${(i * perWord).toFixed(1)}s`}>{r}</li>)}
          </ul>
          <span class="v-roles-static">{roles.join(' · ')}</span>
        </div>
      )}
      {page.affiliation && <p class="v-affiliation">{page.affiliation}</p>}
      <p class="v-socials">
        {settings.socials.map((s) => (
          <a
            href={s.url}
            title={cap(s.label)}
            aria-label={cap(s.label)}
            target={s.url.startsWith('mailto:') ? undefined : '_blank'}
            rel={s.url.startsWith('mailto:') ? undefined : 'noopener'}
          >
            {social[s.label]
              ? <svg viewBox="0 0 24 24" set:html={social[s.label]} />
              : <span>{s.label.charAt(0).toUpperCase()}</span>}
          </a>
        ))}
      </p>
    </div>
    <div class="v-actions">
      {(page.cv || page.cvUrl) && (
        <a href={page.cv || page.cvUrl} target="_blank" rel="noopener">Download CV <svg viewBox="0 0 24 24" set:html={icon.download} /></a>
      )}
      {email && (
        <a href={email.url}>Contact me <svg viewBox="0 0 24 24" set:html={icon.arrow} /></a>
      )}
    </div>
  </aside>

  <main class="v-card v-content" slot="content">
   <div class="v-panel" id="about">
    <section class="v-section">
      <div class="v-heading"><h2>about me.</h2></div>
      <div class="v-prose">
        {page.headline && <p>{page.headline}</p>}
        {page.bio.map((p) => <p set:html={rich(p)} />)}
      </div>
    </section>

    {page.interests.length > 0 && (
      <section class="v-section">
        <div class="v-heading"><h2>research interests.</h2></div>
        <ul class="v-interests">{page.interests.map((i) => <li>{i}</li>)}</ul>
      </section>
    )}

   </div>

   <div class="v-panel" id="works">
    {works.length > 0 && (
      <section class="v-section v-works">
        <input type="radio" name="filter" id="f-all" checked />
        <input type="radio" name="filter" id="f-research" />
        <input type="radio" name="filter" id="f-project" />
        <div class="v-heading">
          <h2>recent works.</h2>
          <div class="v-tabs">
            <label for="f-all">All</label>
            {hasResearch && <label for="f-research">Research</label>}
            {hasProjects && <label for="f-project">Projects</label>}
          </div>
        </div>
        <div class="v-grid">
          {works.map((w) => (
            <article class="v-work" data-kind={w.data.kind}>
              <a href={`#work-${w.id}`}>
                {w.data.thumbnail
                  ? <img class="v-thumb" src={w.data.thumbnail} alt="" loading="lazy" />
                  : <div class="v-thumb v-thumb--empty" aria-hidden="true">{kindLabel(w.data.kind)}</div>}
                <h3 class="v-work-title">{w.data.title}</h3>
                <p class="v-work-kind">{w.data.draft && 'Draft · '}{kindLabel(w.data.kind)}</p>
              </a>
            </article>
          ))}
        </div>
      </section>
    )}

    {notes.length > 0 && (
      <section class="v-section">
        <div class="v-heading"><h2>writings.</h2></div>
        <ul class="v-writing">
          {notes.map((n) => (
            <li>
              <span class="v-when">{fmt(n.date)}</span>
              <span>
                {n.external
                  ? <a href={n.href} target="_blank" rel="noopener">{n.title} ↗</a>
                  : <a href={n.href}>{n.title}</a>}
                <span class="v-src"> · {n.source}</span>
              </span>
            </li>
          ))}
        </ul>
      </section>
    )}

    <p class="v-footer">
      <span>{settings.copyright}</span>
      <a href="/diary">back to the diary</a>
    </p>
   </div>
  </main>

  <Fragment slot="after">
    {rotatorCss && <style is:inline set:html={rotatorCss} />}
    {works.map((w) => {
      const meta = [w.data.context, w.data.role, w.data.year].filter(Boolean).join(' · ');
      return (
        <div class="v-modal" id={`work-${w.id}`} role="dialog" aria-labelledby={`work-${w.id}-title`}>
          <a class="v-modal-backdrop" href="#works" aria-label="Close"></a>
          <div class="v-modal-box">
            <a class="v-modal-close" href="#works" aria-label="Close">×</a>
            {w.data.thumbnail && <img src={w.data.thumbnail} alt="" />}
            <p class="v-work-kind">{kindLabel(w.data.kind)}</p>
            <h3 id={`work-${w.id}-title`}>{w.data.title}</h3>
            {meta && <p class="v-modal-meta">{meta}</p>}
            <div class="v-prose"><p>{w.data.summary}</p></div>
            {w.data.tags.length > 0 && <p class="v-modal-tags">{w.data.tags.join(' · ')}</p>}
            {w.data.links.some((l) => l.url) && (
              <p class="v-modal-links">
                {w.data.links.filter((l) => l.url).map((l) =>
                  l.url.startsWith('/')
                    ? <a href={l.url}>{l.label} →</a>
                    : <a href={l.url} target="_blank" rel="noopener">{l.label} ↗</a>
                )}
              </p>
            )}
          </div>
        </div>
      );
    })}
  </Fragment>
</ResearchLayout>
