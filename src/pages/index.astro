---
import { getCollection } from 'astro:content';
import ResearchLayout from '../layouts/ResearchLayout.astro';
import { readSingleton } from '../lib/reader';
import { rich } from '../lib/rich';
import { showDrafts } from '../lib/entries';

const page = await readSingleton('researchPage');
const settings = await readSingleton('settings');

const works = (await getCollection('research'))
  .filter((w) => showDrafts || !w.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
// research: ongoing work first (a status of "Ongoing", or a year ending in
// "present"), then completed; projects keep their order
const isOngoing = (w: (typeof works)[number]) =>
  /ongoing|in progress|present/i.test(w.data.status ?? '') || /present/i.test(w.data.year ?? '');
const research = works
  .filter((w) => w.data.kind === 'research')
  .sort((a, b) => Number(isOngoing(b)) - Number(isOngoing(a)));
const projects = works.filter((w) => w.data.kind === 'project');

// what a research row says on the page: the excerpt field, or else the first
// sentence of the summary (abbreviations like "Dr." and "vs." don't end one);
// the labelled sections, tags and links wait under "more"
const firstSentence = (text: string) => {
  const m = text.match(/^([\s\S]+?(?<!\b(?:Prof|Dr|Mr|Ms|Mrs|vs|Fig|No|St|e\.g|i\.e))[.!?])\s+(?=[A-Z"“(])/);
  return m ? { head: m[1], rest: text.slice(m[0].length) } : { head: text, rest: '' };
};
const teaser = (w: (typeof works)[number]) =>
  w.data.excerpt ? { head: w.data.excerpt, rest: '' } : firstSentence(w.data.summary);

// papers: newest first; drafts only in dev and previews
const papers = (await getCollection('papers'))
  .filter((p) => showDrafts || !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const statusLabel: Record<string, string> = { preprint: 'Preprint', 'under-review': 'Under review', 'in-preparation': 'In preparation' };
const year = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', timeZone: 'UTC' });

// news: short dated lines, newest first; drafts only in dev and previews
const news = (await getCollection('news'))
  .filter((n) => showDrafts || !n.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// experience and honors share one list, newest first by the date written in
// "when" ("Aug – Dec 2025", "2026 – present", "May 2025 – May 2026"); the
// latest year and month mentioned count, "present" sorts to the top, and
// items with no date go last in the order they were entered
const MONTHS = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];
const whenKey = (when?: string | null) => {
  const t = (when ?? '').toLowerCase();
  if (/present|ongoing|now/.test(t)) return Number.MAX_SAFE_INTEGER;
  const years = [...t.matchAll(/\b(?:19|20)\d{2}\b/g)].map((m) => Number(m[0]));
  if (years.length === 0) return -1;
  // the end of the range: the latest year, and the last month named
  const months = [...t.matchAll(/\b(jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\b/g)].map((m) => MONTHS.indexOf(m[1]));
  const season = /spring/.test(t) ? 4 : /summer/.test(t) ? 7 : /fall|autumn/.test(t) ? 10 : /winter/.test(t) ? 0 : -1;
  const month = months.length > 0 ? months[months.length - 1] : season >= 0 ? season : 11;
  return Math.max(...years) * 12 + month;
};
type Row = { title: string; detail?: string | null; when?: string | null; key: number; order: number };
const timeline: Row[] = [
  ...(page.experience ?? []).filter((e) => e.role || e.org).map((e, i) => ({ title: e.role, detail: e.org, when: e.when, key: whenKey(e.when), order: i })),
  ...(page.honors ?? []).filter((h) => h.title).map((h, i) => ({ title: h.title, detail: h.detail, when: h.when, key: whenKey(h.when), order: 1000 + i })),
].sort((a, b) => b.key - a.key || a.order - b.order);
const hasHonors = (page.honors ?? []).some((h) => h.title);


// writing: published musings ticked for the research profile, newest first
type Note = { title: string; date: Date; href: string; external: boolean; source: string };
let notes: Note[] = [];
if (page.showWriting) {
  const musings = await getCollection('musings');
  notes = musings
    .map((e) => ({ entry: e, base: '/musings/', source: 'musings' }))
    .filter(({ entry }) => !entry.data.draft && entry.data.research)
    .map(({ entry, base, source }) => ({
      title: entry.data.title,
      date: entry.data.date,
      href: entry.data.externalUrl ?? `${base}${entry.id}`,
      external: Boolean(entry.data.externalUrl),
      source,
    }))
    .sort((a, b) => b.date.valueOf() - a.date.valueOf());
}

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
// proper names for the social links, keyed by the label in site settings
const properName: Record<string, string> = { email: 'Email', github: 'GitHub', linkedin: 'LinkedIn', medium: 'Medium', x: 'X' };
const cap = (s: string) => properName[s] ?? s.charAt(0).toUpperCase() + s.slice(1);

const meta = (w: (typeof works)[number]) =>
  [w.data.context, w.data.role, w.data.year].filter(Boolean).join(' · ');
const isExternal = (url: string) => !url.startsWith('/') && !url.startsWith('#');

// the three detail fields read differently for a study and for a project
const detailLabels = (kind: string) =>
  kind === 'research'
    ? { question: 'Research question', contribution: 'My contribution', findings: 'Findings' }
    : { question: 'The problem', contribution: 'What I did', findings: 'Outcome' };
const details = (w: (typeof works)[number]) => {
  const l = detailLabels(w.data.kind);
  return [
    { label: l.question, value: w.data.question },
    { label: l.contribution, value: w.data.contribution },
    { label: l.findings, value: w.data.findings },
  ].filter((d) => d.value);
};

// bio and summaries are plain text with two shortcuts:
// ==phrase== becomes a highlight, **phrase** becomes bold

// rotating titles under the name, CSS-only: each word gets the same
// animation, offset by its index, so the keyframes depend on the count
const roles = page.roles.filter(Boolean);
const perWord = 2.6; // seconds each word stays
const total = roles.length * perWord;
const on = (100 / roles.length).toFixed(3);
const fade = (4 / roles.length).toFixed(3);
const rotatorCss = roles.length > 1
  ? `.v-roles li { animation: v-rotate ${total}s infinite; }
@keyframes v-rotate {
  0% { opacity: 0; transform: translateY(6px); }
  ${fade}% { opacity: 1; transform: none; }
  ${(Number(on) - Number(fade)).toFixed(3)}% { opacity: 1; transform: none; }
  ${on}% { opacity: 0; transform: translateY(-6px); }
  100% { opacity: 0; }
}`
  : '';

// one simple line-icon set, drawn for this page; social ones keyed by the
// label used in site settings, anything unknown falls back to a letter
const icon = {
  download: '<path d="M12 4v11"/><path d="M7 10l5 5 5-5"/><path d="M5 20h14"/>',
};
const social: Record<string, string> = {
  email: '<rect x="3" y="5" width="18" height="14" rx="3"/><path d="M3 8l9 6 9-6"/>',
  github:
    '<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"/>',
  linkedin: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 10.5V17"/><path d="M8 7.5v.01"/><path d="M12 17v-3.5a2.25 2.25 0 0 1 4.5 0V17"/><path d="M12 10.5V17"/>',
  x: '<path d="M5 4l14 16"/><path d="M19 4L5 20"/>',
  medium: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M7 16V8l5 6 5-6v8"/>',
};
---

<ResearchLayout
  title={page.name}
  description={page.name}
>
  <aside class="v-profile" slot="profile">
    <div class="v-identity">
      {page.headshot && <img class="v-photo" src={page.headshot} alt={page.name} width="220" height="264" />}
      <div class="v-identity-text">
      <h1>{page.name}</h1>
      {roles.length > 0 && (
        <div class="v-role">
          <ul class="v-roles">
            {roles.map((r, i) => <li style={`animation-delay: ${(i * perWord).toFixed(1)}s`}>{r}</li>)}
          </ul>
          <span class="v-roles-static">{roles.join(' · ')}</span>
        </div>
      )}
      {page.affiliation && <p class="v-affiliation">{page.affiliation}</p>}
      <p class="v-socials">
        {settings.socials.map((s) => (
          <a
            href={s.url}
            title={cap(s.label)}
            aria-label={cap(s.label)}
            target={s.url.startsWith('mailto:') ? undefined : '_blank'}
            rel={s.url.startsWith('mailto:') ? undefined : 'noopener'}
          >
            {social[s.label]
              ? <svg viewBox="0 0 24 24" set:html={social[s.label]} />
              : <span>{s.label.charAt(0).toUpperCase()}</span>}
          </a>
        ))}
      </p>
      </div>
    </div>
    <div class="v-actions">
      {(page.cv || page.cvUrl) && (
        <a href={page.cv || page.cvUrl} target="_blank" rel="noopener">Download CV <svg viewBox="0 0 24 24" set:html={icon.download} /></a>
      )}
    </div>
  </aside>

  <main class="v-content" slot="content">
    <section class="v-section" id="about">
      <div class="v-heading"><h2>about me.</h2></div>
      <div class="v-prose">
        {page.headline && <p>{page.headline}</p>}
        {page.bio.map((p) => <p set:html={rich(p)} />)}
      </div>
    </section>

    {page.interests.length > 0 && (
      <section class="v-section" id="interests">
        <div class="v-heading"><h2>research interests.</h2></div>
        <ul class="v-interests">{page.interests.map((i) => <li>{i}</li>)}</ul>
      </section>
    )}

    {news.length > 0 && (
      <section class="v-section" id="news">
        <div class="v-heading"><h2>news.</h2></div>
        <div class="v-scroll v-news" tabindex="0" aria-label="News, newest first">
          <ul>
            {news.map((n) => (
              <li>
                <span class="v-when">{n.data.when || fmt(n.data.date)}</span>
                <span>
                  {n.data.draft && <span class="v-draft">Draft · </span>}
                  {n.data.url
                    ? isExternal(n.data.url)
                      ? <a href={n.data.url} target="_blank" rel="noopener">{n.data.title}</a>
                      : <a href={n.data.url}>{n.data.title}</a>
                    : n.data.title}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {research.length > 0 && (
      <section class="v-section" id="research">
        <div class="v-heading"><h2>research.</h2></div>
        {research.map((w) => {
          const t = teaser(w);
          const ongoing = isOngoing(w);
          const hasMore = Boolean(details(w).length || w.data.tags.length || w.data.links.some((l) => l.url));
          return (
          <article class={`v-research${ongoing ? ' is-ongoing' : ''}`} id={`work-${w.id}`}>
            {w.data.thumbnail && (
              <a class="v-figure" href={w.data.thumbnail} target="_blank" rel="noopener" title="Open the figure at full size">
                <img src={w.data.thumbnail} alt={`Figure from ${w.data.title}`} loading="lazy" />
              </a>
            )}
            <div class="v-research-body">
              <p class="v-status">
                <span class="v-status-dot" aria-hidden="true"></span>
                {ongoing ? 'Ongoing' : 'Completed'}{w.data.draft && <span class="v-draft"> · Draft</span>}
              </p>
              <h3>{w.data.title}</h3>
              {meta(w) && <p class="v-meta">{meta(w)}</p>}
              <p class="v-excerpt" set:html={rich(t.head)} />
              {hasMore && (
                <details class="v-more">
                  <summary><span class="v-more-open">more</span><span class="v-more-close">less</span></summary>
                  {details(w).length > 0 && (
                    <dl class="v-details v-prose">
                      {details(w).map((d) => (
                        <div>
                          <dt>{d.label}</dt>
                          <dd set:html={rich(d.value!)} />
                        </div>
                      ))}
                    </dl>
                  )}
                  {w.data.tags.length > 0 && <p class="v-tags">{w.data.tags.join(' · ')}</p>}
                  {w.data.links.some((l) => l.url) && (
                    <p class="v-links v-links--text">
                      {w.data.links.filter((l) => l.url).map((l) =>
                        isExternal(l.url!)
                          ? <a href={l.url!} target="_blank" rel="noopener">{l.label.toLowerCase()} ↗</a>
                          : <a href={l.url!}>{l.label.toLowerCase()} →</a>
                      )}
                    </p>
                  )}
                </details>
              )}
            </div>
          </article>
          );
        })}
      </section>
    )}

    {(papers.length > 0 || page.papersNote) && (
      <section class="v-section" id="papers">
        <div class="v-heading"><h2>papers.</h2></div>
        {papers.length > 0 ? papers.map((p) => (
          <article class="v-paper" id={`paper-${p.id}`}>
            {p.data.thumbnail && (
              <a class="v-figure" href={p.data.thumbnail} target="_blank" rel="noopener" title="Open the figure at full size">
                <img src={p.data.thumbnail} alt={`Figure from ${p.data.title}`} loading="lazy" />
              </a>
            )}
            <div>
              <h3>{p.data.draft && <span class="v-draft">Draft · </span>}{p.data.title}</h3>
              {p.data.authors.length > 0 && (
                <p class="v-authors">
                  {p.data.authors.filter((a) => a.name).map((a, i, all) => {
                    const me = a.name.replace(/\*$/, '') === page.name;
                    const name = me ? <strong>{a.name}</strong> : a.url ? <a href={a.url} target="_blank" rel="noopener">{a.name}</a> : a.name;
                    return <>{name}{i < all.length - 1 && ', '}</>;
                  })}
                </p>
              )}
              <p class="v-meta">
                {[p.data.venue, year(p.data.date)].filter(Boolean).join(' · ')}
                {statusLabel[p.data.status] && <span class="v-paper-status">{statusLabel[p.data.status]}</span>}
              </p>
              {p.data.summary && <p class="v-excerpt" set:html={rich(p.data.summary)} />}
              {(p.data.links.some((l) => l.url) || p.data.bibtex) && (
                <p class="v-links v-links--text">
                  {p.data.links.filter((l) => l.url).map((l) =>
                    isExternal(l.url!)
                      ? <a href={l.url!} target="_blank" rel="noopener">{l.label.toLowerCase()}</a>
                      : <a href={l.url!}>{l.label.toLowerCase()}</a>
                  )}
                  {p.data.bibtex && <a href={`#bib-${p.id}`} class="v-bib-toggle" data-bib={`bib-${p.id}`}>bibtex</a>}
                </p>
              )}
              {p.data.bibtex && <pre class="v-bibtex" id={`bib-${p.id}`} hidden>{p.data.bibtex}</pre>}
            </div>
          </article>
        )) : (
          <p class="v-placeholder">{page.papersNote}</p>
        )}
      </section>
    )}

    {projects.length > 0 && (
      <section class="v-section" id="projects">
        <div class="v-heading"><h2>selected projects.</h2></div>
        <div class="v-scroll v-projects-scroll" tabindex="0" aria-label="Selected projects">
        <div class="v-projects">
          {projects.map((w) => (
            <article class="v-project">
              <a href={`#work-${w.id}`}>
                <h3>{w.data.draft && <span class="v-draft">Draft · </span>}{w.data.title}</h3>
                {meta(w) && <p class="v-meta">{meta(w)}</p>}
                <p class="v-clamp" set:html={rich(w.data.summary)} />
                <span class="v-more">details →</span>
              </a>
            </article>
          ))}
        </div>
        </div>
      </section>
    )}

    {notes.length > 0 && (
      <section class="v-section" id="writing">
        <div class="v-heading"><h2>writing.</h2><a class="v-heading-link" href="/musings">all musings →</a></div>
        <div class={notes.length > 5 ? 'v-scroll v-writing-scroll' : undefined} tabindex={notes.length > 5 ? 0 : undefined} aria-label={notes.length > 5 ? 'Writings' : undefined}>
        <ul class="v-writing">
          {notes.map((n) => (
            <li>
              <span class="v-when">{fmt(n.date)}</span>
              <span>
                {n.external
                  ? <a href={n.href} target="_blank" rel="noopener">{n.title} ↗</a>
                  : <a href={n.href}>{n.title}</a>}
              </span>
            </li>
          ))}
        </ul>
        </div>
      </section>
    )}

    {timeline.length > 0 && (
      <section class="v-section" id="experience">
        <div class="v-heading"><h2>{hasHonors ? 'experience and honors.' : 'experience.'}</h2></div>
        <div class="v-scroll v-exp-scroll" tabindex="0" aria-label="Experience and honors">
          <ul class="v-exp">
            {timeline.map((r) => (
              <li>
                <span><span class="v-exp-role">{r.title}</span>{r.detail && <span class="v-exp-org"> · {r.detail}</span>}</span>
                {r.when && <span class="v-when">{r.when}</span>}
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <p class="v-footer">
      <span>{settings.copyright}</span>
    </p>
  </main>

  <Fragment slot="after">
    {rotatorCss && <style is:inline set:html={rotatorCss} />}
    {projects.map((w) => (
      <div class="v-modal" id={`work-${w.id}`} role="dialog" aria-labelledby={`work-${w.id}-title`}>
        <a class="v-modal-backdrop" href="#projects" aria-label="Close"></a>
        <div class="v-modal-box">
          <a class="v-modal-close" href="#projects" aria-label="Close">×</a>
          {w.data.thumbnail && <img src={w.data.thumbnail} alt="" />}
          <p class="v-work-kind">Project</p>
          <h3 id={`work-${w.id}-title`}>{w.data.title}</h3>
          {meta(w) && <p class="v-modal-meta">{meta(w)}</p>}
          <div class="v-prose"><p set:html={rich(w.data.summary)} /></div>
          {(w.data.question || w.data.contribution || w.data.findings) && (
            <dl class="v-details v-prose">
              {details(w).map((d) => (
                <div>
                  <dt>{d.label}</dt>
                  <dd set:html={rich(d.value!)} />
                </div>
              ))}
            </dl>
          )}
          {w.data.tags.length > 0 && <p class="v-tags">{w.data.tags.join(' · ')}</p>}
          {w.data.links.some((l) => l.url) && (
            <p class="v-links v-links--text">
              {w.data.links.filter((l) => l.url).map((l) =>
                isExternal(l.url!)
                  ? <a href={l.url!} target="_blank" rel="noopener">{l.label.toLowerCase()} ↗</a>
                  : <a href={l.url!}>{l.label.toLowerCase()} →</a>
              )}
            </p>
          )}
        </div>
      </div>
    ))}
  </Fragment>
</ResearchLayout>
