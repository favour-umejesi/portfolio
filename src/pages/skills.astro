---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TitleBlock from '../components/TitleBlock.astro';
import Sweetie from '../components/doodles/Sweetie.astro';

const groups = (await getCollection('skills')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  title="Skills — The Diary of a Lucid Dame"
  description="Favour Umejesi's toolbox: frontend, backend, ML & data, and tools."
  active="skills"
  quote="I'm not bragging, I'm just keeping records."
>
  <TitleBlock title="Skills" underlineWidth={180} path="M2 7q24-6 48 0t48 0 48 0 48 0">
    <Sweetie slot="doodle" />
  </TitleBlock>

  <div class="skills-grid">
    {groups.map((group) => (
      <section class="panel">
        <h2 class="skill-cat">{group.data.category}</h2>
        <p class="skill-items">{group.data.items.join(' · ')}</p>
      </section>
    ))}
  </div>
</BaseLayout>
