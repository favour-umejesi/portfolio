---
import { getCollection } from 'astro:content';
import MusingsLayout from '../../../layouts/MusingsLayout.astro';
import EntryRow from '../../../components/EntryRow.astro';
import { showDrafts, playlistParts } from '../../../lib/entries';

export async function getStaticPaths() {
  const posts = (await getCollection('musings')).filter(
    (post) => showDrafts || !post.data.draft
  );
  // a playlist only gets a page once it holds a visible entry
  return (await getCollection('series'))
    .map((series) => ({ series, parts: playlistParts(posts, series.id) }))
    .filter(({ parts }) => parts.length > 0)
    .map(({ series, parts }) => ({
      params: { playlist: series.id },
      props: { series, parts },
    }));
}

const { series, parts } = Astro.props;
---

<MusingsLayout
  title={`${series.data.title} — Favour Umejesi`}
  description={series.data.description ?? `A series of musings by Favour Umejesi: ${series.data.title}`}
>
  <p class="w-meta">Playlist · {parts.length} {parts.length === 1 ? 'part' : 'parts'} · start at part 01</p>
  <h1 class="w-title">{series.data.title}</h1>
  {series.data.description && <div class="w-intro"><p>{series.data.description}</p></div>}

  <ul class="w-list">
    {parts.map((post, i) => <EntryRow post={post} part={i + 1} />)}
  </ul>

  <p class="back-link"><a href="/musings">← all musings</a></p>
</MusingsLayout>
