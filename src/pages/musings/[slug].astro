---
import { getCollection, render } from 'astro:content';
import MusingsLayout from '../../layouts/MusingsLayout.astro';
import { entryMeta, showDrafts, playlistParts } from '../../lib/entries';

export async function getStaticPaths() {
  const posts = (await getCollection('musings')).filter(
    (post) => showDrafts || !post.data.draft
  );
  const allSeries = await getCollection('series');
  return posts
    .filter((post) => !post.data.externalUrl)
    .map((post) => {
      // entries filed in a playlist know their part number and neighbours
      const series = allSeries.find((s) => s.id === post.data.series);
      const parts = series ? playlistParts(posts, series.id) : [];
      const at = parts.findIndex((p) => p.id === post.id);
      const playlist = series && {
        id: series.id,
        title: series.data.title,
        part: at + 1,
        total: parts.length,
        prev: parts[at - 1],
        next: parts[at + 1],
      };
      return { params: { slug: post.id }, props: { post, playlist } };
    });
}

const { post, playlist } = Astro.props;
const partHref = (p: typeof post) => p.data.externalUrl ?? `/musings/${p.id}`;
// neighbouring parts published elsewhere (e.g. Medium) open in a new tab
const outbound = (p: typeof post) => (p.data.externalUrl ? { target: '_blank', rel: 'noopener' } : {});
const { Content } = await render(post);
// mood photos close the entry: a strip of prints under the writing
const mood = (post.data.moodPhotos ?? []).filter((photo) => photo.image);
---

<MusingsLayout
  title={post.data.title}
  description={post.data.excerpt ?? `A musing by Favour Umejesi: ${post.data.title}`}
>
  <a slot="top-right" class="w-top-back" href={playlist ? `/musings/playlists/${playlist.id}` : '/musings'}>
    ← {playlist ? 'back to the playlist' : 'all musings'}
  </a>
  <article class="article-page">
    <div class="article-column">
      <header>
        {playlist && (
          <p class="w-meta playlist-crumb">
            Part {playlist.part} of {playlist.total} · <a href={`/musings/playlists/${playlist.id}`}>{playlist.title}</a>
          </p>
        )}
        <h1 class="w-title">{post.data.title}</h1>
        <p class="w-meta">{post.data.draft && <span class="w-draft">Draft · </span>}{entryMeta(post.data.date, post.data.readTime)}</p>
        {post.data.tags.length > 0 && <p class="w-tags">{post.data.tags.join(' · ')}</p>}
      </header>
      <div class="article-body">
        <Content />
      </div>
    </div>
  </article>

  {mood.length > 0 && (
    <div class="mood">
      {post.data.moodNote && <p class="mood-note">{post.data.moodNote}</p>}
      <div class="mood-strip">
        {mood.map((photo) => photo.note ? (
          <figure class="mood-card has-back">
            <button class="mood-flip" type="button" aria-pressed="false" aria-label={`Flip the photo: ${photo.caption || 'photo'}`}>
              <span class="mood-3d">
              <span class="taped-photo mood-face mood-front">
                <img src={photo.image} alt={photo.caption || ''} loading="lazy" />
                {photo.caption && <span class="taped-caption">{photo.caption}</span>}
                <span class="mood-hint" aria-hidden="true">↻ flip</span>
              </span>
              <span class="taped-photo mood-face mood-back">
                <span class="mood-back-text">{photo.note}</span>
              </span>
              </span>
            </button>
          </figure>
        ) : (
          <figure class="mood-card">
            <span class="taped-photo mood-face">
              <img src={photo.image} alt={photo.caption || ''} loading="lazy" />
              {photo.caption && <span class="taped-caption">{photo.caption}</span>}
            </span>
          </figure>
        ))}
      </div>
    </div>
  )}

  {playlist && (playlist.prev || playlist.next) && (
    <nav class="playlist-nav" aria-label={`More from ${playlist.title}`}>
      {playlist.prev
        ? <a href={partHref(playlist.prev)} {...outbound(playlist.prev)}>← part {playlist.part - 1}: {playlist.prev.data.title}</a>
        : <span></span>}
      {playlist.next && <a class="playlist-next" href={partHref(playlist.next)} {...outbound(playlist.next)}>part {playlist.part + 1}: {playlist.next.data.title} →</a>}
    </nav>
  )}

  <script>
    // a mood photo with a note on the back turns over when clicked
    document.querySelectorAll<HTMLButtonElement>('.mood-flip').forEach((card) => {
      card.addEventListener('click', () => {
        const flipped = card.getAttribute('aria-pressed') === 'true';
        card.setAttribute('aria-pressed', String(!flipped));
        card.closest('.mood-card')?.classList.toggle('is-flipped', !flipped);
      });
    });
  </script>

  <p class="back-link">
    {playlist && <><a href={`/musings/playlists/${playlist.id}`}>← back to the playlist</a> · </>}
    <a href="/musings">{playlist ? 'all musings' : '← all musings'}</a>
  </p>
</MusingsLayout>
