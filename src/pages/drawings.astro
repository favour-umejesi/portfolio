---
import MusingsLayout from '../layouts/MusingsLayout.astro';
import { readSingleton } from '../lib/reader';

const page = await readSingleton('drawingsPage');
// a drawing only counts once a picture is uploaded
const drawings = page.drawings.filter((d) => d.image);
const pictures = page.pictures.filter((p) => p.image);
---

<MusingsLayout
  title="Drawings"
  description="Drawings by Favour Umejesi: learning to draw again, one sketch at a time."
>
  <div class="w-title-row">
    <h1 class="w-title">drawings.</h1>
    <a class="w-title-link" href="/musings">explore musings →</a>
  </div>
  {page.intro.length > 0 && (
    <div class="w-intro">
      {page.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  )}

  {drawings.length > 0 ? (
    <div class="d-grid">
      {drawings.map((d) => (
        <figure class={`taped-photo d-item${d.glow ? ' has-glow' : ''}`} style={d.glow ? `--glow: ${d.glow}` : undefined}>
          <span class="d-pic">
            <img src={d.image} alt={d.caption || 'A drawing'} loading="lazy" />
          </span>
          {(d.caption || d.when) && (
            <figcaption>{[d.caption, d.when].filter(Boolean).join(' · ')}</figcaption>
          )}
        </figure>
      ))}
    </div>
  ) : (
    <p class="w-empty">Nothing on the wall yet.</p>
  )}

  {pictures.length > 0 && (
    <section class="p-section" aria-labelledby="bits">
      <h2 class="p-title" id="bits">bits and pieces.</h2>
      {page.picturesIntro && <p class="p-intro">{page.picturesIntro}</p>}
      <div class="p-grid">
        {pictures.map((p) => (
          <figure class="taped-photo p-item">
            <img src={p.image} alt={p.caption || 'A snapshot'} loading="lazy" />
            {(p.caption || p.when) && (
              <figcaption>
                {p.caption}
                {p.when && <span class="p-when">{p.caption ? ' · ' : ''}{p.when}</span>}
              </figcaption>
            )}
          </figure>
        ))}
      </div>
    </section>
  )}
</MusingsLayout>
