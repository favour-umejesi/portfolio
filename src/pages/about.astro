---
import BaseLayout from '../layouts/BaseLayout.astro';
import TitleBlock from '../components/TitleBlock.astro';
import Greg from '../components/doodles/Greg.astro';
import { readSingleton } from '../lib/reader';

const about = await readSingleton('about');

// chips render three per row, matching the original tag-rows layout
const likeRows: string[][] = [];
for (let i = 0; i < about.likes.length; i += 3) {
  likeRows.push(about.likes.slice(i, i + 3));
}

// snapshots only count once a photo is actually uploaded
const photos = about.photos.filter((photo) => photo.image);
---

<BaseLayout
  title="About — The Diary of a Lucid Dame"
  description="About Favour Umejesi: CS + Math student at Grambling State, aspiring relevant engineer, climate nonprofit founder."
  active="about"
  quote="Let me get something straight: this is a PORTFOLIO, not a diary."
  quoteBy="Lucid Dame"
>
  <TitleBlock title="About" underlineWidth={190} path="M2 7q24-6 48 0t48 0 48 0 48 0">
    <Greg slot="doodle" />
  </TitleBlock>

  <section class="panel bio">
    {about.bio.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <div class="spread">
    <section class="panel list-items">
      <p class="panel-label">WHAT I'M UP TO —</p>
      {about.whatImUpTo.map((item) => <p>→ {item}</p>)}
    </section>
    <section class="panel">
      <p class="panel-label">STUFF I LIKE —</p>
      <div class="tag-rows">
        {likeRows.map((row) => (
          <div class="tag-row">
            {row.map((chip) => <span class="chip">{chip}</span>)}
          </div>
        ))}
      </div>
    </section>
  </div>

  {photos.length > 0 && (
    <section class="snapshots">
      <p class="section-label">LATELY, IN PICTURES —</p>
      <div class="snapshot-grid">
        {photos.map((photo) => (
          <figure class="snapshot">
            <img src={photo.image} alt={photo.caption || 'A snapshot of what I have been up to'} loading="lazy" />
            {photo.caption && <figcaption>{photo.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </section>
  )}
</BaseLayout>
