---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TitleBlock from '../components/TitleBlock.astro';
import Susan from '../components/doodles/Susan.astro';
import EntryCard from '../components/EntryCard.astro';
import PlaylistCard from '../components/PlaylistCard.astro';
import { showDrafts, playlistParts } from '../lib/entries';
import { readSingleton } from '../lib/reader';

const musingsPage = await readSingleton('musingsPage');

// drafts render in dev and preview deploys (marked DRAFT), never in production
const posts = (await getCollection('musings'))
  .filter((post) => showDrafts || !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// playlists: one mixtape card per series, freshest first; a playlist only
// shows once it holds a visible entry
const playlists = (await getCollection('series'))
  .map((series) => ({ series, parts: playlistParts(posts, series.id) }))
  .filter(({ parts }) => parts.length > 0)
  .sort(
    (a, b) =>
      b.parts[b.parts.length - 1].data.date.valueOf() -
      a.parts[a.parts.length - 1].data.date.valueOf()
  );

// entries filed in a playlist live on its page, not as loose cards here
const filed = new Set(playlists.flatMap(({ parts }) => parts.map((post) => post.id)));
const loose = posts.filter((post) => !filed.has(post.id));
---

<BaseLayout
  title="Musings — The Diary of a Lucid Dame"
  description="Musings by Favour Umejesi: AI, automation, and diary entries on Medium."
  active="musings"
  quote="Don't expect me to be all ‘Dear Diary’ this and ‘Dear Diary’ that."
  quoteBy="Greg Heffley"
>
  <TitleBlock title="Musings" underlineWidth={250} path="M2 7q24-6 48 0t48 0 48 0 48 0 48 0">
    <Susan slot="doodle" />
  </TitleBlock>

  <section class="panel bio">
    {musingsPage.intro.map((paragraph) => <p>{paragraph}</p>)}
  </section>

  <div class="article-grid">
    {playlists.map(({ series, parts }) => (
      <PlaylistCard
        id={series.id}
        title={series.data.title}
        description={series.data.description}
        count={parts.length}
        draft={parts.every((post) => post.data.draft)}
      />
    ))}
    {loose.map((post) => <EntryCard post={post} />)}
  </div>

  <p class="more-note">more diary entries coming soon...</p>

  <figure class="desk-doodle">
    <svg width="300" height="200" viewBox="0 0 360 240" aria-label="Doodle of me hunched over a table, writing intently under a desk lamp">
      <g fill="none" stroke="#111" stroke-linecap="round" stroke-linejoin="round">
        <!-- table -->
        <rect x="148" y="150" width="192" height="7" rx="3" fill="#f6f1e3" stroke-width="2.4" pathLength="1" style="--i:0"/>
        <path d="M166 157 L166 226" stroke-width="2.4" pathLength="1" style="--i:1"/>
        <path d="M322 157 L322 226" stroke-width="2.4" pathLength="1" style="--i:2"/>
        <!-- chair -->
        <path d="M52 112 Q68 107 84 112" stroke-width="2.2" pathLength="1" style="--i:3"/>
        <path d="M52 112 L56 168" stroke-width="2.4" pathLength="1" style="--i:4"/>
        <rect x="52" y="168" width="66" height="6" rx="3" fill="#f6f1e3" stroke-width="2.2" pathLength="1" style="--i:5"/>
        <path d="M64 174 L64 226" stroke-width="2.4" pathLength="1" style="--i:6"/>
        <path d="M108 174 L108 226" stroke-width="2.4" pathLength="1" style="--i:7"/>
        <!-- greg: hunched back, chest, legs -->
        <path d="M135 103 Q105 122 100 168" stroke-width="2.5" pathLength="1" style="--i:8"/>
        <path d="M162 109 Q152 128 150 148" stroke-width="2.4" pathLength="1" style="--i:9"/>
        <path d="M100 170 Q122 173 144 174" stroke-width="2.4" pathLength="1" style="--i:10"/>
        <path d="M144 174 L144 224" stroke-width="2.4" pathLength="1" style="--i:11"/>
        <path d="M144 224 L160 224" stroke-width="2.4" pathLength="1" style="--i:12"/>
        <path d="M136 172 L136 220" stroke-width="2.2" pathLength="1" style="--i:13"/>
        <path d="M136 220 L149 220" stroke-width="2.2" pathLength="1" style="--i:14"/>
        <!-- writing arm -->
        <path d="M118 122 Q158 126 200 142" stroke-width="2.4" pathLength="1" style="--i:15"/>
        <!-- head bent over the desk — the lucid dame herself: bun, swoop of hair, glasses, earring -->
        <ellipse cx="121" cy="74" rx="9" ry="8" fill="#111" stroke="#111" stroke-width="2" class="ink-both" pathLength="1" style="--i:16"/>
        <ellipse cx="155" cy="84" rx="27" ry="28" fill="#f6f1e3" stroke-width="2.5" pathLength="1" style="--i:17"/>
        <path d="M130 97 Q120 72 140 57 Q158 48 174 59 Q182 66 181 75 Q175 76 171 80 Q161 82 152 81 Q141 82 136 84 Q131 86 131 91 Z" fill="#111" stroke="#111" stroke-width="2" stroke-linejoin="round" class="ink-both" pathLength="1" style="--i:18"/>
        <path d="M133 78 Q123 80 124 88 Q125 95 134 93" fill="#f6f1e3" stroke-width="2.2" pathLength="1" style="--i:19"/>
        <circle cx="128" cy="96.5" r="1.8" fill="#111" stroke="none" class="ink-fill" style="--i:20"/>
        <!-- round glasses, eyes down on the page -->
        <circle cx="153" cy="90" r="2.2" fill="#111" stroke="none" class="ink-fill" style="--i:21"/>
        <circle cx="169" cy="92" r="2.2" fill="#111" stroke="none" class="ink-fill" style="--i:22"/>
        <circle cx="152" cy="88.5" r="6" stroke-width="1.9" pathLength="1" style="--i:23"/>
        <circle cx="168" cy="90.5" r="6" stroke-width="1.9" pathLength="1" style="--i:24"/>
