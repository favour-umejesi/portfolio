---
import { getCollection } from 'astro:content';
import MusingsLayout from '../layouts/MusingsLayout.astro';
import EntryRow from '../components/EntryRow.astro';
import PlaylistRow from '../components/PlaylistRow.astro';
import { showDrafts, playlistParts } from '../lib/entries';
import { readSingleton } from '../lib/reader';

const musingsPage = await readSingleton('musingsPage');

// drafts render in dev and preview deploys (marked Draft), never in production
const posts = (await getCollection('musings'))
  .filter((post) => showDrafts || !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

// playlists: one row per series, freshest first; a playlist only shows once
// it holds a visible entry
const playlists = (await getCollection('series'))
  .map((series) => ({ series, parts: playlistParts(posts, series.id) }))
  .filter(({ parts }) => parts.length > 0)
  .sort(
    (a, b) =>
      b.parts[b.parts.length - 1].data.date.valueOf() -
      a.parts[a.parts.length - 1].data.date.valueOf()
  );

// entries filed in a playlist live on its page, not as their own row here
const filed = new Set(playlists.flatMap(({ parts }) => parts.map((post) => post.id)));
const loose = posts.filter((post) => !filed.has(post.id));
---

<MusingsLayout
  title="Musings"
  description="Musings by Favour Umejesi: notes on research, machine learning, and figuring things out."
>
  <h1 class="w-title">musings.</h1>
  {musingsPage.intro.length > 0 && (
    <div class="w-intro">
      {musingsPage.intro.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  )}

  {playlists.length + loose.length > 0 ? (
    <ul class="w-list">
      {playlists.map(({ series, parts }) => (
        <PlaylistRow
          id={series.id}
          title={series.data.title}
          description={series.data.description}
          count={parts.length}
          draft={parts.every((post) => post.data.draft)}
        />
      ))}
      {loose.map((post) => <EntryRow post={post} />)}
    </ul>
  ) : (
    <p class="w-empty">Nothing published yet.</p>
  )}
</MusingsLayout>
