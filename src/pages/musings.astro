        <!-- comma nose -->
        <path transform="translate(158,97)" d="M0 0 Q7 1 6 5 Q5 8 2 7" stroke-width="2.2" pathLength="1" style="--i:27"/>
        <!-- small focused lips -->
        <path d="M155 107 Q158 105 161 107 Q164 105.5 167 107.5" stroke-width="2" pathLength="1" style="--i:28"/>
        <path d="M157 109.5 Q161.5 111 166 109.7" stroke-width="1.8" pathLength="1" style="--i:29"/>
        <!-- hand, pencil, frantic-scribble marks -->
        <circle cx="203" cy="143" r="5" fill="#f6f1e3" stroke-width="2.2" pathLength="1" style="--i:30"/>
        <path d="M201 138 L216 147" stroke-width="2.2" pathLength="1" style="--i:31"/>
        <path d="M212 130 L219 126" stroke-width="1.8" pathLength="1" style="--i:32"/>
        <path d="M221 137 L228 134" stroke-width="1.8" pathLength="1" style="--i:33"/>
        <!-- paper -->
        <path d="M186 150 L196 133 L252 133 L242 150 Z" fill="#fff" stroke-width="2.2" pathLength="1" style="--i:34"/>
        <path d="M202 139 L234 139" stroke-width="1.8" pathLength="1" style="--i:35"/>
        <path d="M197 144 L217 144" stroke-width="1.8" pathLength="1" style="--i:36"/>
        <!-- lamp: base, arm, shade, light -->
        <path d="M284 150 Q284 140 298 140 Q312 140 312 150 Z" fill="#f6f1e3" stroke-width="2.4" pathLength="1" style="--i:37"/>
        <path d="M298 140 L305 106" stroke-width="2.4" pathLength="1" style="--i:38"/>
        <path d="M305 106 L291 89" stroke-width="2.4" pathLength="1" style="--i:39"/>
        <path d="M291 89 L259 100 L283 124 Z" fill="#f6f1e3" stroke-width="2.4" pathLength="1" style="--i:40"/>
        <path d="M254 111 L242 121" stroke-width="1.8" pathLength="1" style="--i:41"/>
        <path d="M269 128 L259 139" stroke-width="1.8" pathLength="1" style="--i:42"/>
      </g>
    </svg>
    <figcaption>an artistic drawing of me as a contributor lol</figcaption>
  </figure>
</BaseLayout>
