---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TitleBlock from '../components/TitleBlock.astro';
import Greg from '../components/doodles/Greg.astro';

const law = await getEntry('lawPage', 'patent-law');
if (!law) throw new Error('Missing content: src/content/pages/patent-law.mdoc');
const { Content } = await render(law);
---

<BaseLayout
  title="The Lucid Dame Patent Law"
  description="The Lucid Dame Patent Law: the story behind this design, and the one rule... don't copy me."
  quote="Violators will be written about in this diary."
>
  <TitleBlock
    title="The Lucid Dame Patent Law"
    underlineWidth={620}
    viewBoxWidth={626}
    path="M2 7q24-6 48 0t48 0 48 0 48 0 48 0 48 0 48 0 48 0 48 0 48 0 48 0 48 0 48 0"
  >
    <Greg slot="doodle" />
  </TitleBlock>

  <p class="section-label">OFFICIAL LEGAL DOCUMENT (SORT OF) —</p>
  <section class="panel bio law-body">
    <Content />
    {law.data.signoff && <p class="law-sign">{law.data.signoff}</p>}
  </section>
</BaseLayout>
