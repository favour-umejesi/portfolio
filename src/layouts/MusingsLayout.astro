---
// The musings share the research profile's plain white page: one reading
// column, serif headings, a small top bar back to the profile.
import '../styles/plain.css';
import '../styles/musings.css';
import { readSingleton } from '../lib/reader';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const settings = await readSingleton('settings');
const properName: Record<string, string> = { email: 'Email', github: 'GitHub', linkedin: 'LinkedIn', medium: 'Medium', x: 'X' };
const cap = (s: string) => properName[s] ?? s.charAt(0).toUpperCase() + s.slice(1);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title.trim()}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,500,100&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;1,8..60,400&display=swap" rel="stylesheet" />
</head>
<body class="writing">
  <header class="w-top">
    <a class="w-home" href="/">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"/><path d="M5.5 10v10h4.5v-6h4v6h4.5V10"/></svg>
      <span>back to homepage</span>
    </a>
    <slot name="top-right" />
  </header>

  <main class="w-main">
    <slot />
  </main>

  <footer class="w-footer">
    <span>{settings.copyright}</span>
    <span>
      {settings.socials.map((s, i) => (
        <>{i > 0 && ' · '}<a href={s.url} target={s.url.startsWith('mailto:') ? undefined : '_blank'} rel={s.url.startsWith('mailto:') ? undefined : 'noopener'}>{cap(s.label)}</a></>
      ))}
    </span>
  </footer>
</body>
</html>
