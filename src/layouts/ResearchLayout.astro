---
// The research profile: a compact profile card on the left (small photo,
// name, rotating role, socials, CV + contact) that stays put while the
// content beside it, the page itself, scrolls section by section.
// Monochrome and Notion-plain: black on white, hairline borders, gold only
// where an accent word would otherwise be blue. Loads none of the diary styles.
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
import '../styles/plain.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,500,100&display=swap" rel="stylesheet" />
</head>
<body class="research">
  <div class="v-frame">
    <div class="v-side">
      <slot name="profile" />
    </div>
    <slot name="content" />
  </div>
  <slot name="after" />
  <script is:inline>
    // Project popups open and close without touching the URL; without JS the
    // same links fall back to :target. The news box fades its bottom edge
    // only when there is more to scroll.
    (() => {
      const closeAll = () => document.querySelectorAll('.v-modal.is-open').forEach((m) => m.classList.remove('is-open'));
      const open = (id) => {
        const m = document.getElementById(id);
        if (!m || !m.classList.contains('v-modal')) return false;
        closeAll();
        m.classList.add('is-open');
        return true;
      };
      document.querySelectorAll('.v-project > a[href^="#work-"]').forEach((a) =>
        a.addEventListener('click', (e) => { e.preventDefault(); open(a.getAttribute('href').slice(1)); }));
      document.querySelectorAll('.v-modal a[href="#projects"]').forEach((a) =>
        a.addEventListener('click', (e) => { e.preventDefault(); closeAll(); }));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });

      // arriving with a shared project link: open it, then clean the URL
      const h = location.hash.slice(1);
      if (h.startsWith('work-') && open(h)) history.replaceState(null, '', location.pathname);

      const boxes = document.querySelectorAll('.v-scroll');
      const fit = () => boxes.forEach((b) => b.classList.toggle('is-scrollable', b.scrollHeight > b.clientHeight + 1));
      fit();
      window.addEventListener('resize', fit);
      window.addEventListener('load', fit);

    })();
  </script>
</body>
</html>

<style is:global>
  body.research { padding: 40px 0 56px; }
  .research svg { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }

  /* frame: profile card | open content, centered; the card stays put while
     the page scrolls past it */
  .v-frame {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: 44px;
    align-items: start;
    width: min(1040px, 100% - 48px);
    margin: 0 auto;
  }
  .v-side { position: sticky; top: 40px; }
  /* profile: a photo resting on the page, then the identity and two links,
     no box around any of it */
  .v-profile { display: flex; flex-direction: column; }
  .v-identity { display: flex; flex-direction: column; align-items: flex-start; }
  .v-photo {
    display: block;
    width: 220px;
    height: 264px; /* upright, like a print */
    object-fit: cover;
    object-position: center top;
    margin-bottom: 22px;
  }
  .v-identity-text { display: contents; }
  /* the name is set on one line, justified to the width of the photo */
  .v-identity h1 {
    width: 220px;
    font-family: var(--v-heading);
    font-size: 30px;
    font-weight: 500;
    line-height: 1.1;
    white-space: nowrap;
    text-justify: inter-character; /* the slack goes between letters, not into one wide word gap */
    letter-spacing: -0.01em;
    font-variation-settings: "SOFT" 100;
    text-align: justify;
    text-align-last: justify;
  }
  .v-role { color: var(--v-gold); font-weight: 600; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; margin-top: 14px; width: 100%; }
  .v-roles { list-style: none; position: relative; height: 1.6em; }
  .v-roles li { position: absolute; inset: 0; opacity: 0; }
  .v-roles li:first-child { opacity: 1; }
  .v-roles-static { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .v-roles { display: none; }
    .v-roles-static { display: inline; }
  }
  .v-affiliation { color: var(--v-muted); font-size: 13px; margin-top: 8px; line-height: 1.5; }
  .v-socials { display: flex; gap: 2px; margin: 16px 0 0 -7px; }
  .v-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    color: var(--v-text);
  }
  .v-socials a:hover { background: var(--v-hover); }
  .v-actions { display: flex; flex-wrap: wrap; gap: 6px 18px; margin-top: 12px; }
  .v-actions a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 600;
    color: var(--v-muted);
  }
  .v-actions a:hover { color: var(--v-gold); }
  .v-actions svg { width: 14px; height: 14px; }

  /* content: the page itself, no card */
  .v-section { scroll-margin-top: 40px; }
  .v-section + .v-section { margin-top: 48px; }
  .v-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }
  .v-heading h2 { font-family: var(--v-heading); font-size: 25px; font-weight: 500; line-height: 1.2; letter-spacing: -0.01em; font-variation-settings: "SOFT" 100; }
  .v-heading-link { font-size: 13px; font-weight: 500; color: var(--v-muted); }
  .v-heading-link:hover { color: var(--v-gold); }
  .v-prose { max-width: 66ch; }
  .v-prose p + p { margin-top: 12px; }
  .v-when { color: var(--v-muted); font-size: 13px; }
  .v-meta { color: var(--v-muted); font-size: 13.5px; margin-top: 2px; }
  .v-draft { color: var(--v-gold); font-weight: 500; }
  .v-placeholder { font-style: italic; color: var(--v-muted); }

  .v-interests { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 24px; max-width: 66ch; }
  .v-interests li { padding-left: 16px; position: relative; }
  .v-interests li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.95em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--v-text);
  }


  /* boxes that scroll on their own (news, selected projects), so a list can
     grow for years without pushing the rest of the page down */
  .v-scroll {
    overflow-y: auto;
    padding-right: 14px;
    scrollbar-width: thin;
    scrollbar-color: rgba(55, 53, 47, 0.25) transparent;
    border-radius: 4px;
  }
  /* macOS hides overlay scrollbars when idle; a styled one stays visible, so
     the box reads as scrollable at a glance (Chrome, Safari, Edge) */
  .v-scroll::-webkit-scrollbar { width: 6px; }
  .v-scroll::-webkit-scrollbar-track { background: var(--v-hover); border-radius: 3px; }
  .v-scroll::-webkit-scrollbar-thumb { background: rgba(55, 53, 47, 0.28); border-radius: 3px; }
  .v-scroll::-webkit-scrollbar-thumb:hover { background: rgba(55, 53, 47, 0.45); }
  .v-scroll:not(.is-scrollable)::-webkit-scrollbar { display: none; }
  .v-scroll:focus-visible { outline: 2px solid var(--v-gold); outline-offset: 6px; }
  .v-scroll.is-scrollable { mask-image: linear-gradient(to bottom, #000 calc(100% - 32px), transparent); }
  .v-scroll.is-scrollable > * { padding-bottom: 28px; }
  .v-news { max-height: 212px; }
  .v-news ul { list-style: none; display: grid; gap: 10px; }
  .v-news li { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 14px; align-items: baseline; }
  .v-news .v-when { white-space: nowrap; }
  .v-news a { border-bottom: 1px solid var(--v-line); }
  .v-news a:hover { color: var(--v-gold); border-color: currentColor; }

  /* research: a publication-style row per study, figure on the left,
     excerpt and links on the right, the rest behind a small "more" toggle.
     Ongoing work is marked with a gold dot, completed with a grey one. */
  .v-research {
    display: grid;
    grid-template-columns: 170px minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }
  .v-research + .v-research { margin-top: 36px; }
  .v-figure { display: block; border: 1px solid var(--v-line); transition: border-color 0.15s; }
  .v-figure:hover { border-color: rgba(55, 53, 47, 0.3); }
  .v-figure img {
    display: block;
    width: 100%;
    height: auto; /* the figure keeps its own proportions and fills the frame */
  }
  .v-research:not(:has(.v-figure)) { grid-template-columns: minmax(0, 1fr); }
  .v-status { display: inline-flex; align-items: center; gap: 7px; font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--v-muted); }
  .v-status-dot { width: 7px; height: 7px; border-radius: 50%; background: rgba(55, 53, 47, 0.3); }
  .is-ongoing .v-status { color: var(--v-gold); }
  .is-ongoing .v-status-dot { background: var(--v-gold); box-shadow: 0 0 0 3px rgba(184, 134, 11, 0.18); }
  .v-research h3 { font-size: 17px; font-weight: 600; line-height: 1.35; margin-top: 4px; }
  .v-excerpt { margin-top: 10px; max-width: 66ch; }
  .v-more { margin-top: 6px; }
  .v-more summary {
    display: inline-block;
    cursor: pointer;
    font-size: 13px;
    font-weight: 500;
    color: var(--v-muted);
    list-style: none;
  }
  .v-more summary::-webkit-details-marker { display: none; }
  .v-more summary::after { content: " ▾"; font-size: 11px; }
  .v-more[open] summary::after { content: " ▴"; }
  .v-more summary:hover { color: var(--v-gold); }
  .v-more-close { display: none; }
  .v-more[open] .v-more-open { display: none; }
  .v-more[open] .v-more-close { display: inline; }
  .v-more .v-prose, .v-more .v-details { margin-top: 10px; }
  .v-more .v-tags { margin-top: 12px; }
  /* links under a study or in a project popup: plain text, separated by dots */
  .v-links--text { margin-top: 12px; font-size: 13.5px; font-weight: 500; }
  .v-links--text a { color: var(--v-muted); }
  .v-links--text a:hover { color: var(--v-gold); }
  .v-links--text a + a::before { content: "·"; margin: 0 10px; color: var(--v-muted); }
  .v-details { margin-top: 14px; display: grid; gap: 10px; }
  .v-details dt { font-size: 11px; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: var(--v-gold); }
  .v-details dd { margin: 0; white-space: pre-line; }
  .v-tags { margin-top: 12px; color: var(--v-muted); font-size: 13px; }
  .v-links { display: flex; flex-wrap: wrap; }

  /* selected projects: compact, two to a row, inside a scrolling box; the
     full write-up opens in a popup */
  .v-projects-scroll { max-height: 300px; }
  .v-projects { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 36px; }
  .v-project { padding: 0 0 26px; }
  .v-project > a { display: block; }
  .v-project h3 { font-size: 15.5px; font-weight: 600; line-height: 1.35; }
  .v-project > a:hover h3 { color: var(--v-gold); }
  .v-clamp {
    margin-top: 8px;
    font-size: 14px;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .v-more { display: inline-block; margin-top: 6px; font-size: 13px; color: var(--v-muted); }
  .v-project > a:hover .v-more { color: var(--v-text); }

  /* popup for a project's full write-up: via class with JS, via :target without */
  .v-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 50;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(0, 0, 0, 0.45);
  }
  .v-modal:target, .v-modal.is-open { display: flex; }
  .v-modal-backdrop { position: absolute; inset: 0; }
  .v-modal-box {
    position: relative;
    width: min(560px, 100%);
    max-height: min(640px, 100vh - 48px);
    overflow-y: auto;
    background: var(--v-bg);
    border-radius: var(--v-radius);
    padding: 24px 28px 28px;
    font-size: 14.5px;
  }
  .v-modal-close {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    font-size: 20px;
    line-height: 1;
    color: var(--v-muted);
  }
  .v-modal-close:hover { background: var(--v-hover); color: var(--v-text); }
  .v-modal-box img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 240px;
    object-fit: contain; /* natural proportions, full image, capped to the viewport */
    border-radius: 6px;
    border: 1px solid var(--v-line);
    margin-bottom: 18px;
  }
  .v-work-kind { color: var(--v-muted); font-size: 13px; }
  .v-modal-box h3 { font-size: 19px; font-weight: 600; line-height: 1.3; }
  .v-modal-meta { color: var(--v-muted); font-size: 13.5px; margin: 4px 0 14px; }
  .v-modal-box .v-prose { max-width: none; }

  .v-writing { list-style: none; display: grid; gap: 8px; }
  /* more than five writings: the list scrolls, five rows tall */
  .v-writing-scroll { max-height: calc(5 * 1.7em + 4 * 8px); }
  .v-writing li { display: grid; grid-template-columns: 76px minmax(0, 1fr); gap: 14px; align-items: baseline; }
  .v-writing a:hover { color: var(--v-gold); }

  .v-exp { list-style: none; display: grid; gap: 10px; }
  .v-exp li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; align-items: baseline; }
  .v-exp-role { font-weight: 600; }
  .v-exp-org { color: var(--v-muted); }
  .v-exp .v-when { white-space: nowrap; }
  .v-exp-scroll { max-height: 236px; }

  .v-footer {
    margin-top: 56px;
    font-size: 12.5px;
    color: var(--v-muted);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px 20px;
  }
  .v-footer a:hover { color: var(--v-text); }

  @media (max-width: 1000px) {
    .v-frame { grid-template-columns: 260px minmax(0, 1fr); gap: 36px; }
    .v-photo { width: 200px; height: 240px; }
    .v-identity h1 { width: 200px; font-size: 26px; }
  }
  @media (max-width: 800px) {
    body.research { padding: 24px 0 40px; }
    .v-frame {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      margin: 0;
      padding: 0 16px;
      gap: 32px;
    }
    .v-side { position: static; }
    /* photo beside the identity on a tablet */
    .v-identity { flex-direction: row; align-items: center; gap: 22px; }
    .v-photo { margin-bottom: 0; flex: none; width: 150px; height: 180px; }
    .v-identity h1 { width: auto; font-size: 26px; text-align: left; text-align-last: left; }
    .v-identity-text { display: flex; flex-direction: column; align-items: flex-start; min-width: 0; }
    .v-role { width: auto; }
    .v-section + .v-section { margin-top: 40px; }
    .v-research { grid-template-columns: 1fr; gap: 14px; }
    .v-figure { max-width: 260px; }
    .v-modal-box { padding: 22px 20px 24px; }
    .v-writing li, .v-news li { grid-template-columns: 1fr; gap: 0; }
    .v-exp li { grid-template-columns: 1fr; gap: 0; }
  }
  @media (max-width: 560px) {
    .v-identity { flex-direction: column; align-items: flex-start; }
    .v-photo { margin-bottom: 14px; }
    .v-interests { grid-template-columns: 1fr; }
    .v-projects { grid-template-columns: 1fr; }
    .v-modal { padding: 12px; }
    .v-modal-box { max-height: calc(100vh - 24px); max-height: calc(100dvh - 24px); padding: 20px 16px 22px; }
    .v-modal-close { top: 6px; right: 6px; }
  }
</style>
