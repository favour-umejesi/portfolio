---
// The "serious" face of the site: a card layout (profile card + content
// card, small side nav) in the spirit of hanng.me, kept monochrome and
// Notion-plain: black on white, hairline borders, gold only where an accent
// word would otherwise be blue. Loads none of the diary styles.
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT@9..144,500,100&display=swap" rel="stylesheet" />
</head>
<body class="research">
  <div class="v-frame">
    <slot name="sidenav" />
    <slot name="profile" />
    <slot name="content" />
  </div>
  <slot name="after" />
  <script is:inline>
    // Swap the about/works cards and open/close work popups without touching
    // the URL. Everything here also works without JS via the #hash fallback.
    (() => {
      const body = document.body;
      const content = document.querySelector('.v-content');
      const show = (panel) => { body.dataset.panel = panel; if (content) content.scrollTop = 0; requestAnimationFrame(masonry); };

      // pack the works grid: each card spans as many 8px rows as it is tall
      const grid = document.querySelector('.v-grid');
      const masonry = () => {
        if (!grid || grid.offsetParent === null) return;
        grid.dataset.masonry = '';
        grid.querySelectorAll('.v-work').forEach((card) => {
          if (getComputedStyle(card).display === 'none') { card.style.gridRowEnd = ''; return; }
          const inner = card.firstElementChild;
          card.style.gridRowEnd = `span ${Math.ceil((inner.getBoundingClientRect().height + 28) / 8)}`;
        });
      };
      if (grid) {
        grid.querySelectorAll('img').forEach((img) => img.addEventListener('load', masonry));
        document.querySelectorAll('.v-works input[type="radio"]').forEach((r) => r.addEventListener('change', () => requestAnimationFrame(masonry)));
        window.addEventListener('resize', masonry);
        window.addEventListener('load', masonry);
      }
      const closeAll = () => document.querySelectorAll('.v-modal.is-open').forEach((m) => m.classList.remove('is-open'));
      const open = (id) => { const m = document.getElementById(id); if (m) { closeAll(); show('works'); m.classList.add('is-open'); } };

      document.querySelectorAll('.v-sidenav a[href^="#"]').forEach((a) =>
        a.addEventListener('click', (e) => { e.preventDefault(); show(a.getAttribute('href').slice(1)); }));
      document.querySelectorAll('.v-work > a[href^="#work-"]').forEach((a) =>
        a.addEventListener('click', (e) => { e.preventDefault(); open(a.getAttribute('href').slice(1)); }));
      document.querySelectorAll('.v-modal a[href="#works"]').forEach((a) =>
        a.addEventListener('click', (e) => { e.preventDefault(); closeAll(); }));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(); });

      // arriving with a hash (a shared link): honour it, then clean the URL
      const h = location.hash.slice(1);
      if (h === 'works' || h === 'about') show(h);
      else if (h.startsWith('work-')) open(h);
      else show('about');
      if (h) history.replaceState(null, '', location.pathname);
    })();
  </script>
</body>
</html>

<style is:global>
  :root {
    --v-bg: #ffffff;
    --v-text: #37352f;                     /* Notion's ink */
    --v-muted: rgba(55, 53, 47, 0.65);
    --v-line: rgba(55, 53, 47, 0.12);
    --v-hover: rgba(55, 53, 47, 0.06);
    --v-gold: #b8860b;        /* accent words, in place of blue */
    --v-heading: "Fraunces", "Iowan Old Style", Georgia, serif; /* section headings only */
    --v-font: ui-sans-serif, -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, "Apple Color Emoji", Arial, sans-serif; /* Notion's stack */
    --v-radius: 8px;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { height: 100%; }

  body.research {
    min-height: 100%;
    font-family: var(--v-font);
    font-size: 15px;
    line-height: 1.7;
    color: var(--v-text);
    background: var(--v-bg);
    -webkit-font-smoothing: antialiased;
    padding: 32px 0; /* on body, not the frame, so the top margin can't collapse and add scroll */
  }
  .research a { color: inherit; text-decoration: none; }
  .research strong { font-weight: 600; }
  .research mark { background: #fbf3db; color: inherit; padding: 0 3px; border-radius: 3px; } /* Notion's yellow highlight */
  .research svg { width: 18px; height: 18px; stroke: currentColor; fill: none; stroke-width: 1.75; stroke-linecap: round; stroke-linejoin: round; }

  /* frame: side nav | profile card | content card, centered in the viewport */
  .v-frame {
    display: grid;
    grid-template-columns: 64px 380px minmax(0, 1fr);
    gap: 20px;
    align-items: stretch;
    width: min(1160px, 100% - 48px);
    height: min(720px, 100vh - 64px);
    min-height: 600px;
    margin: 0 auto;
  }
  .v-card {
    background: var(--v-bg);
    border: 1px solid var(--v-line);
    border-radius: var(--v-radius);
  }

  /* side nav */
  .v-sidenav { align-self: center; display: flex; flex-direction: column; padding: 4px; gap: 2px; }
  .v-sidenav a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3px;
    padding: 10px 4px 8px;
    border-radius: 6px;
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--v-muted);
  }
  .v-sidenav a:hover { background: var(--v-hover); color: var(--v-text); }
  /* the active card's nav item */
  body:not([data-panel="works"]) .v-sidenav a[href="#about"],
  body[data-panel="works"] .v-sidenav a[href="#works"] { color: var(--v-text); background: var(--v-hover); }

  /* profile card */
  .v-profile { display: flex; flex-direction: column; overflow: hidden; }
  .v-photo {
    display: block;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-height: 360px;
    object-fit: cover;
    object-position: center top;
  }
  .v-photo--empty {
    width: 100%;
    aspect-ratio: 1 / 1;
    max-height: 360px;
    background: var(--v-hover);
  }
  .v-identity {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 22px 28px 18px;
  }
  .v-identity h1 { font-size: 25px; font-weight: 600; line-height: 1.25; letter-spacing: -0.01em; }
  .v-role { color: var(--v-gold); font-weight: 500; font-size: 14px; margin-top: 2px; width: 100%; }
  .v-roles { list-style: none; position: relative; height: 1.7em; }
  .v-roles li { position: absolute; inset: 0; text-align: center; opacity: 0; }
  .v-roles li:first-child { opacity: 1; }
  .v-roles-static { display: none; }
  @media (prefers-reduced-motion: reduce) {
    .v-roles { display: none; }
    .v-roles-static { display: inline; }
  }
  .v-affiliation { color: var(--v-muted); font-size: 13px; margin-top: 8px; line-height: 1.5; }
  .v-socials { display: flex; gap: 6px; margin-top: 14px; }
  .v-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 6px;
    color: var(--v-text);
  }
  .v-socials a:hover { background: var(--v-hover); }
  .v-actions { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--v-line); }
  .v-actions a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 15px 10px;
    font-size: 13px;
    font-weight: 600;
  }
  .v-actions a + a { border-left: 1px solid var(--v-line); }
  .v-actions a:hover { background: var(--v-hover); }
  .v-actions a:only-child { grid-column: 1 / -1; }
  .v-actions svg { width: 15px; height: 15px; }

  /* content card: scrolls internally on desktop */
  .v-content { overflow-y: auto; padding: 32px 36px 36px; }
  /* two cards in one slot: about (default) and works. A small script swaps
     them via body[data-panel] so the URL stays clean; without JS the same
     links fall back to :target */
  .v-panel { display: none; }
  body:not([data-panel="works"]) #about { display: block; }
  body[data-panel="works"] #works { display: block; }
  body:not([data-panel]) #works:target { display: block; }
  body:not([data-panel]):has(#works:target) #about { display: none; }
  body:not([data-panel]):has(.v-modal:target) #works { display: block; }
  body:not([data-panel]):has(.v-modal:target) #about { display: none; }
  .v-section { scroll-margin-top: 32px; }
  .v-section + .v-section { margin-top: 40px; }
  .v-heading {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 12px;
  }
  .v-heading h2 { font-family: var(--v-heading); font-size: 24px; font-weight: 500; line-height: 1.2; letter-spacing: -0.01em; font-variation-settings: "SOFT" 100; }
  .v-prose { max-width: 66ch; }
  .v-prose p + p { margin-top: 12px; }

  .v-interests { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 24px; }
  .v-interests li { padding-left: 16px; position: relative; }
  .v-interests li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.95em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--v-text);
  }

  /* works: CSS-only filter with radio inputs, no client JS */
  .v-works { position: relative; }
  .v-works > input { position: absolute; opacity: 0; pointer-events: none; }
  .v-tabs { display: flex; gap: 16px; font-size: 13.5px; font-weight: 500; }
  .v-tabs label { cursor: pointer; color: var(--v-muted); user-select: none; }
  .v-tabs label:hover { color: var(--v-text); }
  #f-all:checked ~ .v-heading .v-tabs label[for="f-all"],
  #f-research:checked ~ .v-heading .v-tabs label[for="f-research"],
  #f-project:checked ~ .v-heading .v-tabs label[for="f-project"] { color: var(--v-gold); }
  #f-research:checked ~ .v-grid .v-work:not([data-kind="research"]),
  #f-project:checked ~ .v-grid .v-work:not([data-kind="project"]) { display: none; }

  .v-works .v-heading { margin-bottom: 24px; }
  .v-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 24px; align-items: start; }
  /* masonry: the script measures each card and gives it a row span, so a
     card starts right under the previous one in its column */
  .v-grid[data-masonry] { grid-auto-rows: 8px; row-gap: 0; align-items: stretch; }
  .v-grid[data-masonry] .v-work { margin-bottom: 28px; }
  .v-work { text-align: center; }
  .v-work > a { display: block; }
  .v-work > a:hover .v-work-title { color: var(--v-gold); }
  .v-thumb {
    display: block;
    width: 100%;
    height: auto; /* the image keeps its own proportions: fills the card width, never cropped */
    border-radius: 6px;
    border: 1px solid var(--v-line);
  }
  .v-thumb--empty {
    aspect-ratio: 4 / 3;
    background: var(--v-hover);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #bdbdbd;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .v-work-title { font-size: 15.5px; font-weight: 600; margin-top: 12px; line-height: 1.35; }
  .v-work-kind { color: var(--v-muted); font-size: 13px; }

  /* CSS-only detail popup via :target */
  .v-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 50;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(0, 0, 0, 0.45);
  }
  .v-modal:target, .v-modal.is-open { display: flex; }
  .v-modal-backdrop { position: absolute; inset: 0; }
  .v-modal-box {
    position: relative;
    width: min(680px, 100%);
    max-height: calc(100vh - 48px);
    overflow-y: auto;
    background: var(--v-bg);
    border-radius: var(--v-radius);
    padding: 28px 32px 32px;
  }
  .v-modal-close {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    font-size: 20px;
    line-height: 1;
    color: var(--v-muted);
  }
  .v-modal-close:hover { background: var(--v-hover); color: var(--v-text); }
  .v-modal-box img {
    display: block;
    width: 100%;
    height: auto;
    max-height: 62vh;
    object-fit: contain; /* natural proportions, full image, capped to the viewport */
    border-radius: 6px;
    border: 1px solid var(--v-line);
    margin-bottom: 18px;
  }
  .v-modal-box h3 { font-size: 21px; font-weight: 700; line-height: 1.3; }
  .v-modal-meta { color: var(--v-muted); font-size: 13.5px; margin: 4px 0 14px; }
  .v-modal-box .v-prose { max-width: none; }
  .v-research-details { margin-top: 16px; }
  .v-research-details > div + div { margin-top: 14px; }
  .v-research-details dd { margin: 0; white-space: pre-line; }
  .v-modal-tags { margin-top: 14px; color: var(--v-muted); font-size: 13px; }
  .v-modal-links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
  .v-modal-links a {
    padding: 6px 14px;
    border: 1px solid var(--v-line);
    border-radius: 6px;
    font-size: 13px;
    font-weight: 500;
  }
  .v-modal-links a:hover { background: var(--v-hover); }

  .v-writing { list-style: none; display: grid; gap: 8px; }
  .v-writing li { display: grid; grid-template-columns: 80px 1fr; gap: 14px; align-items: baseline; }
  .v-writing .v-when { color: var(--v-muted); font-size: 13px; }
  .v-writing a:hover { color: var(--v-gold); }
  .v-writing .v-src { color: var(--v-muted); font-size: 13px; }

  .v-footer {
    margin-top: 40px;
    font-size: 12.5px;
    color: var(--v-muted);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 6px 20px;
  }
  .v-footer a:hover { color: var(--v-text); }

  @media (max-width: 1000px) {
    .v-frame { grid-template-columns: 330px minmax(0, 1fr); }
    .v-sidenav { display: none; }
    /* no side nav here, so both cards show, stacked */
    .v-panel { display: block !important; }
    .v-panel + .v-panel { margin-top: 40px; }
  }
  @media (max-width: 800px) {
    body.research { padding: 20px 0 32px; }
    .v-frame {
      display: flex;
      flex-direction: column;
      width: 100%;
      height: auto;
      min-height: 0;
      margin: 0;
      padding: 0 16px;
      gap: 16px;
    }
    /* profile card: the photo sits beside the identity, a fixed 200px
       column, so it stays a whole square instead of a cropped band */
    .v-profile {
      display: grid;
      grid-template-columns: 200px minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr) auto;
    }
    .v-photo, .v-photo--empty {
      align-self: stretch;
      height: 100%;
      min-height: 200px;
      max-height: none;
      aspect-ratio: auto;
      object-position: center 20%;
    }
    .v-identity { justify-content: center; padding: 22px 20px 18px; }
    .v-actions { grid-column: 1 / -1; }
    .v-content { overflow: visible; padding: 26px 22px 28px; }
    .v-grid { gap: 24px 18px; }
    .v-grid[data-masonry] .v-work { margin-bottom: 24px; }
    .v-modal-box { padding: 22px 20px 24px; }
    .v-writing li { grid-template-columns: 1fr; gap: 0; }
  }
  @media (max-width: 560px) {
    /* phones: photo on top as a full-width square, everything one column */
    .v-profile { display: flex; }
    .v-photo, .v-photo--empty {
      height: auto;
      min-height: 0;
      aspect-ratio: 1 / 1;
      object-position: center top;
    }
    .v-identity { padding: 20px 18px 16px; }
    .v-grid { grid-template-columns: 1fr; }
    .v-interests { grid-template-columns: 1fr; }
    .v-modal { padding: 12px; }
    .v-modal-box { max-height: calc(100vh - 24px); max-height: calc(100dvh - 24px); padding: 20px 16px 22px; }
    .v-modal-close { top: 6px; right: 6px; }
  }
</style>
