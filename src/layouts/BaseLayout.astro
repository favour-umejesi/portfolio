---
interface Props {
  title: string;
  description: string;
  active?: string;
  bodyClass?: string;
  noindex?: boolean;
  quote: string;
  quoteBy?: string;
  patentLink?: boolean;
  caveat?: boolean;
}

const {
  title,
  description,
  active,
  bodyClass,
  noindex = false,
  quote,
  quoteBy,
  patentLink = false,
  caveat = false,
} = Astro.props;

const nav = [
  { key: 'about', href: '/about' },
  { key: 'experience', href: '/experience' },
  { key: 'projects', href: '/projects' },
  { key: 'skills', href: '/skills' },
  { key: 'theories', href: '/theories' },
  { key: 'musings', href: '/musings' },
];

const fontsHref = caveat
  ? 'https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=Patrick+Hand&family=Patrick+Hand+SC&display=swap'
  : 'https://fonts.googleapis.com/css2?family=Patrick+Hand&family=Patrick+Hand+SC&display=swap';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex" />}
  <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
  <link rel="icon" type="image/png" href="/assets/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/assets/apple-touch-icon.png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href={fontsHref} rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />
</head>
<body class={bodyClass}>
  <div class="page">

    <slot name="before-header" />

    <header class="topbar">
      <a class="diary-mark" href="/">The Diary of a Lucid Dame</a>
      <nav class="nav">
        {nav.map((item) => (
          <a href={item.href} class={active === item.key ? 'active' : undefined}>{item.key}</a>
        ))}
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="footer-row">
        <p class="quote">“{quote}”{quoteBy && <> <span class="by">— {quoteBy}</span></>}</p>
        <div class="footer-right">
          <p class="socials"><a href="mailto:umejesif@gmail.com">email</a> · <a href="https://github.com/favour-umejesi" target="_blank" rel="noopener">github</a> · <a href="https://linkedin.com/in/favour-umejesi" target="_blank" rel="noopener">linkedin</a> · <a href="https://medium.com/@umejesif" target="_blank" rel="noopener">medium</a> · <a href="https://x.com/Odalokoghene" target="_blank" rel="noopener">x</a></p>
        </div>
      </div>
      <p class="copyright">© 2026 Favour Umejesi{patentLink && <> · <a href="/patent-law">the lucid dame patent law</a></>}</p>
    </footer>

    <slot name="after-footer" />

  </div>
</body>
</html>
