                    {
                      "type": "text",
                      "id": "Cn23U",
                      "name": "Lede Text",
                      "fill": "$ink",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "avour Umejesi lives at the intersection of AI, machine learning, and full-stack engineering — building intelligent systems that solve real problems and automate the boring stuff.",
                      "lineHeight": 1.5,
                      "fontFamily": "$font-serif",
                      "fontSize": 15,
                      "fontWeight": "normal"
                    }
                  ]
                },
                {
                  "type": "text",
                  "id": "EPBLW",
                  "name": "Para",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "A computer science student at Grambling State University — with a data-analytics certificate on the side — she treats each project as a chance to make something a little smarter than it strictly needs to be.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-serif",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "d0pv8",
                  "name": "Para",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "Before college she founded a climate-focused nonprofit around UN Goals 11 and 13, reaching more than 500 people with tech-driven campaigns on sustainable cities and climate action.",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-serif",
                  "fontSize": 15,
                  "fontWeight": "normal"
                },
                {
                  "type": "text",
                  "id": "z9X6A",
                  "name": "Para Close",
                  "fill": "$ink",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "These days one question drives the work: how can technology drive sustainability — and how can sustainability shape the future of technology?",
                  "lineHeight": 1.5,
                  "fontFamily": "$font-serif",
                  "fontSize": 15,
                  "fontWeight": "normal",
                  "fontStyle": "italic"
                }
              ]
